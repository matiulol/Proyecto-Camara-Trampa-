# MongoDB local de ANICAM. Nunca subir backend/.env al repositorio.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=Ani_cam
MONGODB_TIMEOUT_MS=5000

# Backblaze B2 S3 (complete solo backend/.env; nunca comparta claves).
B2_DIRECCION_SERVICIO=https://s3.us-east-005.backblazeb2.com
B2_NOMBRE_DEPOSITO=nombre-de-deposito-privado
B2_REGION=us-east-005
B2_IDENTIFICADOR_CLAVE=identificador-de-ejemplo
B2_CLAVE_SECRETA=clave-secreta-de-ejemplo
