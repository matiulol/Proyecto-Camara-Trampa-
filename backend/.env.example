# MongoDB Atlas: reemplace <NUEVA_CONTRASENA_URL_ENCODED> localmente.
# Si la contraseña tiene caracteres reservados (@, :, /, ?, #, etc.), codifíquela
# para URL antes de colocarla aquí. Nunca subir backend/.env al repositorio.
MONGODB_URI=mongodb+srv://Anicam:anicam123@cluster0.vd6ha1z.mongodb.net/Cluster0?retryWrites=true&w=majority
MONGODB_DATABASE=Cluster0
